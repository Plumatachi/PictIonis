{
  "rules": {
    "games": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$gameId": {
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || (!newData.exists() && data.child('players').child(auth.uid).exists()))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "score": {
              ".write": "auth != null && root.child('games').child($gameId).child('players').child(auth.uid).exists()"
            },
            "wordsFound": {
              ".write": "auth != null && root.child('games').child($gameId).child('players').child(auth.uid).exists()"
            }
          }
        },
        "$field": {
          ".write": "auth != null && root.child('games').child($gameId).child('players').child(auth.uid).exists()"
        }
      }
    },
    "drawings": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('games').child($gameId).child('round/drawerUid').val() === auth.uid || (!newData.exists() && root.child('games').child($gameId).child('players').child(auth.uid).exists()))"
      }
    },
    "chats": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && root.child('games').child($gameId).child('players').child(auth.uid).exists()",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('games').child($gameId).child('players').child(auth.uid).exists()",
          ".validate": "newData.child('uid').val() === auth.uid"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "stats": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
